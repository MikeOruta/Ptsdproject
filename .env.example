# Copy this file to .env and fill in real values. .env is never committed.

# SQLite database file, relative to the project root.
DB_PATH=db/ptsd_system.db

# Flask signs session cookies with this. Use a long random string:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# 1 on the live HTTPS server (cookies only sent over HTTPS); 0 on your laptop.
SECURE_COOKIES=0

# Organisation name shown in the header.
ORG_NAME=Defence Health Services

# Emergency number shown to users.
SUPPORT_LINE=999 or 112

# Probability cut-offs for Moderate and High risk.
RISK_MODERATE=0.40
RISK_HIGH=0.70

# Password for the fictional demo accounts created by: python -m db.seed_demo
# (at least 10 characters, letters and numbers). Leave blank on a real deployment.
DEMO_PASSWORD=
